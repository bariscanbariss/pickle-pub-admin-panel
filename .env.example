# ═══════════════════════════════════════════════════════════
#  Pickle Pub Admin Panel - Environment Variables
#  Bu dosyayı .env olarak kopyala: cp .env.example .env
#  Sonra gerçek değerleri gir. .env asla Git'e push edilmez!
# ═══════════════════════════════════════════════════════════

# ─── VERİTABANI (lokal Docker Postgres) ──────────────────
DB_USER=picklepub
DB_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZ
DB_NAME=picklepub

# ─── SUPABASE (storage/auth için hâlâ kullanılıyorsa) ────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── CLOUDFLARE R2 (resim depolama) ──────────────────────
NEXT_PUBLIC_R2_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Not: Admin girişi admin_users tablosunda bcrypt ile saklanır, ADMIN_PASSWORD
# diye bir env değişkeni kodda kullanılmıyor. Admin hesabı oluşturmak için
# scripts/restore-backup.js çalıştırılırken RESTORE_ADMIN_USERNAME ve
# RESTORE_ADMIN_PASSWORD'ü tek seferlik olarak elle geçirin.
